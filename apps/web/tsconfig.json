{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "shadcn-ui": ["../../libs/shadcn-ui/src"],
      "shadcn-ui-utils": ["../../libs/shadcn-ui-utils/src"],
      "shadcn-ui/*": ["../../libs/shadcn-ui/src/*"],
      "shadcn-ui-utils/*": ["../../libs/shadcn-ui-utils/src/*"]
    }
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ],
  "extends": "../../tsconfig.base.json"
}
