# Port the API listens on. Defaults to 3000.
# PORT=3000
MONGODB_URI=mongodb://root:example@localhost:27017/snapsplit?authSource=admin
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Vision model for receipt extraction. Defaults to gemini-3.1-flash-lite.
# GEMINI_MODEL=gemini-3.1-flash-lite
# Max extraction attempts until the parsed receipt is self-consistent. Defaults to 3.
# RECEIPT_EXTRACTION_MAX_ATTEMPTS=3
# How far (in cents) the line sums may drift from the printed total before an
# extraction counts as inconsistent and is retried. Defaults to 50.
# RECEIPT_SUM_TOLERANCE_CENTS=50
# In dev this bucket is seeded by the emulator from .dev/gcs/ (compose.yaml);
# the app never creates buckets itself. In production it is provisioned by infra.
GCS_BUCKET=snapsplit-receipts
# Set to "production" in deployed environments (Bun defaults it to
# "development"). With NODE_ENV=production an unset CORS_ORIGIN is a startup
# error.
# NODE_ENV=production
# Comma-separated list of origins allowed by CORS (full origins, no paths).
# Unset means any origin — allowed outside production, a startup error with
# NODE_ENV=production.
# CORS_ORIGIN=https://app.example.com,https://staging.example.com
# Number of proxies in front of the API. Picks the rate-limit client that many
# entries from the right of x-forwarded-for: 1 for proxies that append the
# client last (ALB, Cloudflare, nginx via $proxy_add_x_forwarded_for), 2 when
# the balancer adds its own address after it (Fly.io, Google HTTP(S) LB).
# Unset/0 keys by the TCP peer, correct only without a proxy. Guessing low
# collapses every caller into one shared bucket and throttles the join route
# globally; guessing high is worse and quieter — the entry it picks is one the
# caller supplied, so a guesser rotates it per request and the limit stops
# applying at all.
# TRUST_PROXY=1
# Dev only: point the GCS client at the fake-gcs-server emulator (compose.yaml).
# Leave unset in production so the client uses real GCS via ADC.
# NOTE: intentionally NOT the SDK-reserved STORAGE_EMULATOR_HOST — that name
# triggers a conflicting auto-emulator mode that 404s against fake-gcs.
GCS_EMULATOR_HOST=http://localhost:4443
