MONGODB_URI=mongodb://root:example@localhost:27017/snapsplit?authSource=admin
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Vision model for receipt extraction. Defaults to gemini-3.1-flash-lite.
# GEMINI_MODEL=gemini-3.1-flash-lite
# Max extraction attempts until the parsed receipt is self-consistent. Defaults to 3.
# RECEIPT_EXTRACTION_MAX_ATTEMPTS=3
# In dev this bucket is seeded by the emulator from .dev/gcs/ (compose.yaml);
# the app never creates buckets itself. In production it is provisioned by infra.
GCS_BUCKET=snapsplit-receipts
# Number of proxies in front of the API. Picks the rate-limit client that many
# entries from the right of x-forwarded-for: 1 for appending proxies
# (nginx, ALB, Cloudflare), 2 when the balancer adds its own address after the
# client (Fly.io, Google HTTP(S) LB). Unset/0 keys by the TCP peer, correct
# only without a proxy. Wrong in either direction, every caller lands in one
# shared bucket and the join route throttles globally.
# TRUST_PROXY=1
# Dev only: point the GCS client at the fake-gcs-server emulator (compose.yaml).
# Leave unset in production so the client uses real GCS via ADC.
# NOTE: intentionally NOT the SDK-reserved STORAGE_EMULATOR_HOST — that name
# triggers a conflicting auto-emulator mode that 404s against fake-gcs.
GCS_EMULATOR_HOST=http://localhost:4443
