{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun --watch apps/api/src/index.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/api",
        "command": "bun test"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "bun build apps/api/src/index.ts --target bun --outdir dist/apps/api"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "biome lint {projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome format --write {projectRoot}"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "biome format {projectRoot}"
      }
    }
  }
}
