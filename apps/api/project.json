{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun --watch apps/api/src/index.ts"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "./dist/apps/api/server"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "!{projectRoot}/test/**"],
      "outputs": ["{projectRoot}/coverage/unit"],
      "options": {
        "cwd": "apps/api",
        "command": "bun test --coverage-dir coverage/unit src"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/api",
        "command": "bun test --preload ./test/setup.ts --coverage-dir coverage/integration test/"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "sh apps/api/scripts/compile.sh bun dist/apps/api/server"
      }
    },
    "build:linux-amd64": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/apps/api-linux/amd64"],
      "options": {
        "command": "sh apps/api/scripts/compile.sh bun-linux-x64 dist/apps/api-linux/amd64/server"
      }
    },
    "build:linux-arm64": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/apps/api-linux/arm64"],
      "options": {
        "command": "sh apps/api/scripts/compile.sh bun-linux-arm64 dist/apps/api-linux/arm64/server"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "biome lint {projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome format --write {projectRoot}"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "biome format {projectRoot}"
      }
    }
  }
}
