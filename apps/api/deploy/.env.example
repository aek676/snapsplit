# Copy to .env next to compose.yaml on the VM (/opt/apps/snapsplit) and fill in.
# docker compose reads this file for the api service. NEVER commit the real .env
# — it holds secrets.

# Image tag to pull for the api service. Use a published tag, e.g. latest, or a
# sha-<7> produced by `bun nx publish api`. The deploy script only rewrites this
# line on the VM.
API_IMAGE_TAG=latest

# Base DuckDNS domain; the caddy-docker-proxy label builds snapsplit-api.<domain>.
DUCKDNS_DOMAIN=your-subdomain.duckdns.org

# API runtime
NODE_ENV=production
# One proxy (Caddy) in front of the API; without this the rate limiter keys every
# caller by Caddy's address and throttles them as one.
TRUST_PROXY=1
# Web origin allowed by CORS. This is the Worker URL (or its custom domain), NOT
# the API's own domain. A missing origin fails at request time in production.
CORS_ORIGIN=https://example.workers.dev
# Gemini key for receipt extraction.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# MongoDB Atlas (M0 free tier)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/snapsplit?retryWrites=true&w=majority
DATABASE_NAME=snapsplit

# Receipt object storage (S3-compatible OCI Object Storage). Fill from:
#   terraform -chdir=infra output s3_endpoint s3_region s3_bucket s3_access_key_id
#   terraform -chdir=infra output -raw s3_secret_access_key
S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_REGION=<region>
S3_BUCKET=snapsplit-receipts
S3_ACCESS_KEY_ID=<s3_access_key_id>
S3_SECRET_ACCESS_KEY=<s3_secret_access_key>
