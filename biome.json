{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/out-tsc",
      "!**/coverage",
      "!**/.nx",
      "!**/*.timestamp*",
      "!**/*.gen.ts",
      "!libs/shadcn-ui",
      "!libs/shadcn-ui-utils"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "error",
            "noReExportAll": "error"
          },
          "style": {
            "useConsistentTypeDefinitions": {
              "level": "error",
              "options": {
                "style": "type"
              }
            },
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "requireAscii": true,
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/app/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app", "**/app/**"],
                    "message": "Unidirectional architecture: src/features must not import from src/app."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/session/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app", "**/app/**"],
                    "message": "Unidirectional architecture: src/features must not import from src/app."
                  },
                  {
                    "group": [
                      "**/features",
                      "**/features/**",
                      "!**/features/session",
                      "!**/features/session/**"
                    ],
                    "message": "No cross-feature imports: compose features in src/app (bulletproof)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/components/**",
        "apps/web/src/hooks/**",
        "apps/web/src/lib/**",
        "apps/web/src/types/**",
        "apps/web/src/utils/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/app",
                      "**/app/**",
                      "**/features",
                      "**/features/**"
                    ],
                    "message": "Unidirectional architecture: shared modules (components, hooks, lib, types, utils) must not import from src/app or src/features."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
