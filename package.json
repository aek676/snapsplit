{
  "name": "snapsplit",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "nx run-many -t serve -p api web",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t tsc:typecheck",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "format": "nx run-many -t format"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@nx/js": "23.0.1",
    "@nx/react": "23.0.1",
    "@nx/vite": "23.0.1",
    "@nx/vitest": "23.0.1",
    "@nx/web": "23.0.1",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "bun-types": "^1.3.14",
    "jiti": "2.4.2",
    "jsdom": "^29.1.1",
    "nx": "23.0.1",
    "tailwindcss": "^4.3.2",
    "tslib": "^2.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "elysia": "^1.4.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
