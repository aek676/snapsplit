{
  "name": "snapsplit",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "libs/*"
    ],
    "catalog": {
      "zod": "^4.4.3"
    }
  },
  "scripts": {
    "dev": "nx run-many -t serve -p api web",
    "preview": "nx run-many -t start preview -p api web",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t tsc:typecheck",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "format": "nx run-many -t format"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@nx-extend/shadcn-ui": "^6.2.5",
    "@nx/js": "23.1.1",
    "@nx/react": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-devtools": "^0.10.10",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.30",
    "@testcontainers/mongodb": "^12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "~4.1.0",
    "bun-types": "^1.3.14",
    "jsdom": "^30.0.1",
    "nx": "23.1.1",
    "tailwindcss": "^4.3.3",
    "testcontainers": "12.1.0",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vitest": "~4.1.0"
  },
  "overrides": {
    "bson": "7.2.0"
  }
}
